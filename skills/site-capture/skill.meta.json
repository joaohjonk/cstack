{
  "slug": "site-capture",
  "type": "capability",
  "summary": "Headless browser for brand work: responsive screenshots, PDFs, snapshots, computed-style tokens, media provenance and page QA",
  "tags": [
    "browser",
    "screenshots",
    "QA",
    "capture",
    "web"
  ],
  "triggers": [
    "screenshot",
    "capture the site",
    "site-capture",
    "check the page on mobile",
    "extract styles",
    "PDF of the page"
  ],
  "required_inputs": [
    "url"
  ],
  "outputs": [
    "work/browse/*/run.json"
  ],
  "required_providers": [
    "playwright-core + chromium"
  ],
  "cost_class": "free",
  "context_class": "s",
  "mutating": false,
  "handoff": [
    "brand-import",
    "competitor-intel",
    "taste-search",
    "brand-verify",
    "creative-review"
  ],
  "fallback": {
    "when_missing": [
      "chromium"
    ],
    "mode": "degraded"
  },
  "last_verified": null,
  "status": "beta"
}
