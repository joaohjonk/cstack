{
  "slug": "creative-autoresearch",
  "type": "playbook",
  "summary": "Bounded keep/discard experiments on one mutable surface against a frozen fixture, with budgets, regressions and stop conditions",
  "tags": [
    "experiments",
    "autoresearch",
    "optimization",
    "overnight"
  ],
  "triggers": [
    "optimize the recipe",
    "overnight run",
    "experiment",
    "improve at scale",
    "A/B the method"
  ],
  "required_inputs": [
    "fixture",
    "mutable surface",
    "budgets",
    "stop conditions"
  ],
  "outputs": [
    "experiments/results.tsv",
    "experiments/runs/*/report.md"
  ],
  "cost_class": "high",
  "context_class": "m",
  "mutating": true,
  "handoff": [
    "prompt-director",
    "model-router",
    "learn-loop"
  ],
  "approval_gates": [
    {
      "id": "start",
      "after_step": "init",
      "artifact": "experiment-run.yaml",
      "never_self_approve": true
    },
    {
      "id": "promote",
      "after_step": "report",
      "artifact": "report.md",
      "never_self_approve": true
    }
  ],
  "fallback": {
    "when_missing": [
      "budget"
    ],
    "mode": "blocked"
  },
  "last_verified": null,
  "status": "beta",
  "required_providers": []
}
