{
  "slug": "creative-autoresearch",
  "type": "playbook",
  "summary": "Bounded keep/discard experiments on one mutable surface against a frozen fixture, with budgets, regressions and stop conditions",
  "tags": [
    "experiments",
    "autoresearch",
    "optimization",
    "overnight"
  ],
  "triggers": [
    "optimize the recipe",
    "overnight run",
    "experiment",
    "improve at scale",
    "A/B the method"
  ],
  "not_for": [
    "generate-media",
    "model-router"
  ],
  "required_inputs": [
    "fixture",
    "mutable surface",
    "budgets",
    "stop conditions"
  ],
  "outputs": [
    "experiments/results.tsv",
    "experiments/runs/*/report.md"
  ],
  "writes": [
    "experiments/",
    "state/cost-ledger.jsonl",
    "state/learnings.jsonl"
  ],
  "cost_class": "high",
  "context_class": "m",
  "mutating": true,
  "handoff": [
    "prompt-director",
    "model-router",
    "learn"
  ],
  "evals": [
    "evals/fixtures/expensive-overnight-batch.yaml"
  ],
  "approval_gates": [
    {
      "id": "start",
      "after_step": "init",
      "artifact": "experiment-run.yaml",
      "never_self_approve": true
    },
    {
      "id": "promote",
      "after_step": "report",
      "artifact": "report.md",
      "never_self_approve": true
    }
  ],
  "baseline": "incumbent",
  "fallback": {
    "when_missing": [
      "budget"
    ],
    "mode": "blocked"
  },
  "compatible_hosts": [
    "claude-code",
    "codex",
    "cursor",
    "gemini-cli",
    "opencode"
  ],
  "destructive": false,
  "version": "0.1.0",
  "last_verified": null,
  "status": "beta",
  "budget": {
    "skill_md_tokens_max": 3200
  },
  "required_providers": [],
  "optional_providers": []
}
