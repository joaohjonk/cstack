{
  "slug": "brand-import",
  "type": "playbook",
  "summary": "Ingest an existing brand into sourced brand state, tokens, entities and seed gold/anti libraries",
  "tags": [
    "brand",
    "import",
    "provenance",
    "tokens"
  ],
  "triggers": [
    "import brand",
    "existing brand",
    "brand guidelines",
    "conflicting assets",
    "brand state stale"
  ],
  "required_inputs": [
    "official assets or brand URLs"
  ],
  "outputs": [
    "brand/brand-system.json",
    "brand/brand-world.json",
    "brand/tokens/*.tokens.json",
    "references/gold",
    "references/anti"
  ],
  "cost_class": "low",
  "context_class": "l",
  "mutating": true,
  "handoff": [
    "brand-verify",
    "taste-search",
    "identity-system",
    "brief"
  ],
  "approval_gates": [
    {
      "id": "consequential-conflicts",
      "after_step": "confirm",
      "artifact": "briefs/import-report-*.md",
      "never_self_approve": true
    }
  ],
  "fallback": {
    "when_missing": [
      "taste-labs"
    ],
    "mode": "local"
  },
  "last_verified": null,
  "status": "beta",
  "required_providers": []
}
