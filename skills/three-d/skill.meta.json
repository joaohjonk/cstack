{
  "slug": "three-d",
  "type": "composite",
  "summary": "Product and brand 3D that keeps product truth: real vs fake 3D, truth-source geometry, official label texture, web and AR budgets",
  "tags": [
    "3d",
    "web-hero",
    "turntable",
    "ar",
    "packshot",
    "glb"
  ],
  "triggers": [
    "rotating product",
