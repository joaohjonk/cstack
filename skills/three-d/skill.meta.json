    "view in ar",
    "360 product",
    "rotate on the homepage",
    "website hero",
    "spinning product"
  ],
  "not_for": [
    "product-fidelity",
    "video-direction"
  ],
  "required_inputs": [
    "outcome",
    "truth source or concept",
    "target reference"
  ],
  "outputs": [
    "work/3d/"
  ],
  "reads": [
    "brand/brand-world.json",
    "assets/official/",
    "registry/models.json"
  ],
  "writes": [
    "work/3d/",
    "state/cost-ledger.jsonl",
    "state/lineage.jsonl"
  ],
  "cost_class": "medium",
