  "mutating": true,
  "destructive": false,
  "handoff": [
    "product-fidelity",
    "generate-media",
    "workflow",
    "brand-verify",
    "creative-review",
    "learn-loop"
  ],
  "evals": [
    "evals/fixtures/3d-label-truth.yaml",
    "evals/fixtures/3d-web-budget.yaml",
    "evals/fixtures/3d-fake-vs-real.yaml",
    "evals/fixtures/3d-ar-scale.yaml",
    "evals/fixtures/3d-provider-missing.yaml",
    "evals/fixtures/3d-tool-injection.yaml"
  ],
  "approval_gates": [
    {
      "id": "path-and-spend",
