    },
    {
      "id": "final-asset",
      "after_step": "verify",
      "artifact": "work/3d/*/report.md",
      "never_self_approve": true
    }
  ],
  "depends_on_fields": [
    "product_representation",
    "packaging_rules",
    "motion"
  ],
  "deterministic_steps": [
    "cstack 3d inspect",
    "cstack 3d frames",
    "cstack 3d blender-script",
    "label overlay check",
    "browse qa"
  ],
  "generative_steps": [
    "generated shape drafts",
    "optional background finish"
  ],
  "required_providers": [],
  "optional_providers": [
    "fal"
  ],
  "baseline": "reference",
  "fallback": {
    "when_missing": [
      "truth source",
      "3d tools",
      "FAL_KEY"
    ],
    "mode": "degraded"
  },
  "compatible_hosts": [
    "claude-code",
    "codex",
    "cursor",
    "gemini-cli",
    "opencode"
  ],
  "version": "0.1.0",
  "last_verified": "2026-10-03",
  "status": "beta",
  "budget": {
    "skill_md_tokens_max": 3200
  }
