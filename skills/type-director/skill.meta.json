{
  "slug": "type-director",
  "type": "capability",
  "summary": "Choose and pair typefaces for the job, build a measurable type system as tokens and rules, and review typography with checks",
  "tags": [
    "typography",
    "type",
    "pairing",
    "type-system",
    "tokens",
    "review"
  ],
  "triggers": [
    "choose a typeface",
    "font pairing",
    "type system",
    "type scale",
    "typography review",
    "fonts feel wrong",
    "hierarchy is a mess"
  ],
  "required_inputs": [
    "brief or brand context",
    "surfaces and languages"
  ],
  "outputs": [
    "work/type/",
    "brand/tokens/type.tokens.json",
    "brand/rules/brand-rules.yaml"
  ],
  "cost_class": "free",
  "context_class": "m",
  "mutating": true,
  "handoff": [
    "identity-system",
    "brand-verify",
    "creative-review",
    "copywriting",
    "learn-loop"
  ],
  "approval_gates": [
    {
      "id": "pairing",
      "after_step": "specimens",
      "artifact": "work/type/*/specimen.html",
      "never_self_approve": true
    },
    {
      "id": "system",
      "after_step": "verify",
      "artifact": "brand/tokens/type.tokens.json",
      "never_self_approve": true
    }
  ],
  "depends_on_fields": [
    "typography",
    "type_hierarchy",
    "voice"
  ],
  "fallback": {
    "when_missing": [
      "font files",
      "browser engine"
    ],
    "mode": "degraded"
  },
  "last_verified": null,
  "status": "beta",
  "required_providers": []
}
