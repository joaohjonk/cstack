#!/usr/bin/env bash
# cstack setup: install dependencies and link skills into your agent host(s).
#   ./setup                 default hosts (see registry/hosts.json)
#   ./setup claude-code     one host: default|auto|all|agents|claude-code|codex|cursor|gemini-cli|opencode|copilot|factory|kiro
#   ./setup --host claude-code   the same, flag form (also --host=claude-code)
# Safe to re-run (idempotent). CSTACK_SETUP_DRY_RUN=1 ./setup shows what it would link.
# Never installs system software, never asks for or stores keys, makes no paid calls.
set -euo pipefail

HOST="default"
while [ $# -gt 0 ]; do
  case "$1" in
    --host) [ $# -ge 2 ] || { printf 'setup: --host needs a name\n' >&2; exit 1; }; HOST="$2"; shift 2 ;;
    --host=*) HOST="${1#--host=}"; shift ;;
    -h|--help) sed -n '2,8p' "$0"; exit 0 ;;
    -*) printf 'setup: unknown option %s (usage: ./setup [host] or ./setup --host <host>)\n' "$1" >&2; exit 1 ;;
    *) HOST="$1"; shift ;;
  esac
done
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

say() { printf '%s\n' "$*"; }
fail() { printf 'setup: %s\n' "$*" >&2; exit 1; }

# 1. Node >= 20 (checked, never installed)
command -v node >/dev/null 2>&1 || fail "Node.js >= 20 is required and was not found. Install it yourself (https://nodejs.org or your version manager), then re-run ./setup."
NODE_MAJOR="$(node -p 'process.versions.node.split(".")[0]')"
[ "$NODE_MAJOR" -ge 20 ] 2>/dev/null || fail "Node.js >= 20 is required (found $(node -v)). Upgrade it yourself, then re-run ./setup."
command -v npm >/dev/null 2>&1 || fail "npm was not found next to node $(node -v). Fix your Node install, then re-run ./setup."
say "node $(node -v) ok"

# 2. npm dependencies: local to this checkout. playwright-core is optional and never downloads a browser here.
export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
if [ -d node_modules/ajv ] && [ -d node_modules/yaml ] && [ -d node_modules/ajv-formats ] && [ node_modules/.package-lock.json -nt package-lock.json ]; then
  say "npm dependencies already installed"
else
  if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --no-audit --no-fund; fi
fi

# 3. Link skills into the agent host(s). Re-running refreshes links; nothing outside the host skill folders is touched.
# CSTACK_SETUP_DRY_RUN=1 prints what would be linked without writing (used by CI).
if [ "${CSTACK_SETUP_DRY_RUN:-}" = "1" ]; then node bin/cstack.mjs setup --host "$HOST" --dry-run; else node bin/cstack.mjs setup --host "$HOST"; fi

# 4. Optional capabilities (reported, never installed)
if node -e "require.resolve('playwright-core')" >/dev/null 2>&1; then
  say "playwright-core present: \`cstack browse\` and JPEG/WebP \`cstack edit paste\` work when a Chromium is available (set CSTACK_CHROMIUM to use your own)."
else
  say "playwright-core absent (optional): browser commands and JPEG/WebP compositing report MISSING; everything else works. To add it: npm ci --include=optional (npm skips optional packages when your npm config sets omit=optional)."
fi

# Quote the path so the alias survives spaces, "&" and other shell characters in the folder name:
# single-quoted alias body, double-quoted path, any single quote in the path written as '\''.
QCLI="\"$ROOT/bin/cstack.mjs\""
QCLI="${QCLI//\'/\'\\\'\'}"
cat <<NEXT

Make \`cstack\` a command (skills and docs call it that); add this line to your shell profile (~/.zshrc or ~/.bashrc):
  alias cstack='node $QCLI'

Next steps (from any folder once the alias is set)
  cstack help                                    list commands
  cstack brand init ~/brands/my-brand --name "My Brand"   start a brand workspace (outside this repo)
  cstack providers                               which providers are usable; keys are env vars by name only
  cstack search "product photoshoot"
  npm run check                                  validate + budgets + tests (run inside this folder)

Paid providers stay off until you export their env vars yourself (see registry/providers.json).
NEXT
