{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cstack.dev/schemas/feedback-event.schema.json",
  "title": "Human feedback event",
  "description": "Preference data: approvals, rejections, gold/anti, A/B pairs, free text, region critique. Preference pairs are first-class.",
  "type": "object",
  "required": [
    "id",
    "date",
    "by",
    "type",
    "artifact_ref"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "date": {
      "type": "string"
    },
    "by": {
      "type": "string"
    },
    "brand_id": {
      "type": "string"
    },
    "type": {
      "enum": [
        "approve",
        "reject",
        "gold",
        "anti",
        "pairwise",
        "comment",
        "region_critique",
        "edit"
      ]
    },
    "artifact_ref": {
      "type": "string"
    },
    "artifact_version": {
      "type": "integer"
    },
    "pair": {
      "type": "object",
      "properties": {
        "a": {
          "type": "string"
        },
        "b": {
          "type": "string"
        },
        "winner": {
          "enum": [
            "a",
            "b",
            "tie",
            "neither"
          ]
        },
        "margin": {
          "enum": [
            "slight",
            "clear",
            "decisive"
          ]
        }
      },
      "additionalProperties": false
    },
    "region": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        },
        "unit": {
          "enum": [
            "px",
            "fraction"
          ]
        }
      },
      "additionalProperties": false
    },
    "reason": {
      "type": "string"
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "general_principle": {
      "type": "string",
      "description": "what this says about taste in general (candidate learning)"
    },
    "project_specific": {
      "type": "string",
      "description": "what is only true for this brief/brand/campaign"
    },
    "axes": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/judgment_axes"
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "surface": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "brief_ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}