{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cstack.dev/schemas/creative-performance.schema.json",
  "title": "Creative performance record",
  "description": "One ad's results for one period, with its decomposition into taxonomy tags. Observational data never implies causation; `cstack creative report` reads these.",
  "type": "object",
  "required": [
    "id",
    "artifact_ref",
    "channel",
    "metrics"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "artifact_ref": {
      "type": "string"
    },
    "experiment_id": {
      "type": "string"
    },
    "channel": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "features": {
      "type": "object",
      "properties": {
        "hook_type": {
          "type": "string"
        },
        "first_frame": {
          "type": "string"
        },
        "product_timing": {
          "type": "string"
        },
        "face": {
          "type": "string"
        },
        "setting": {
          "type": "string"
        },
        "appeal": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "headline_architecture": {
          "type": "string"
        },
        "copy_density": {
          "type": "string"
        },
        "pacing": {
          "type": "string"
        },
        "shot_count": {
          "type": "string"
        },
        "camera_behavior": {
          "type": "string"
        },
        "visual_novelty": {
          "type": "string"
        },
        "creator_vs_studio": {
          "type": "string"
        },
        "cta": {
          "type": "string"
        },
        "duration": {
          "type": "string"
        },
        "offer": {
          "type": "string"
        },
        "landing_page_match": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "legacy free-form features; prefer tags"
    },
    "variable_tested": {
      "type": "string"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "spend": {
      "$ref": "common.schema.json#/$defs/money"
    },
    "confounds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "read": {
      "enum": [
        "repeated",
        "confounded",
        "single_observation",
        "inconclusive"
      ]
    },
    "brand_building_vs_conversion": {
      "type": "string"
    },
    "ad_name": {
      "type": "string"
    },
    "tags": {
      "type": "object",
      "description": "one term per taxonomy family (registry/creative-taxonomy.json); never munge families",
      "properties": {
        "angle": {
          "type": "string"
        },
        "hook_tactic": {
          "type": "string"
        },
        "visual_hook": {
          "type": "string"
        },
        "verbal_hook": {
          "type": "string"
        },
        "mechanic": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "proof": {
          "type": "string"
        },
        "payoff": {
          "type": "string"
        },
        "cta": {
          "type": "string"
        },
        "awareness_stage": {
          "enum": [
            "unaware",
            "problem-aware",
            "solution-aware",
            "product-aware",
            "most-aware"
          ]
        },
        "talent": {
          "type": "string"
        },
        "setting": {
          "type": "string"
        },
        "visual_world": {
          "type": "string"
        },
        "offer": {
          "type": "string"
        },
        "duration": {
          "type": "string"
        },
        "aspect": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "talent_role": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "bet_ref": {
      "type": "string"
    },
    "objective": {
      "enum": [
        "paid_performance",
        "organic_travel",
        "brand_equity"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "provider"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "imported_at": {
          "type": "string"
        },
        "preset": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
