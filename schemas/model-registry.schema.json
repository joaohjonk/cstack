{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cstack.dev/schemas/model-registry.schema.json",
  "title": "Model registry",
  "description": "Living, snapshot-dated facts about models. Prices and latency are snapshots, never permanent truth.",
  "type": "object",
  "required": [
    "updated",
    "models"
  ],
  "properties": {
    "updated": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "model_id",
          "provider",
          "modality",
          "capabilities",
          "last_verified",
          "source"
        ],
        "properties": {
          "model_id": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "provider_model_id": {
            "type": "string",
            "description": "exact endpoint/model name at the provider"
          },
          "modality": {
            "enum": [
              "image",
              "video",
              "vector",
              "audio",
              "text",
              "analysis",
              "3d"
            ],
            "description": "output family; what the model can DO is in capabilities"
          },
          "capabilities": {
            "type": "array",
            "description": "open kebab-case vocabulary, e.g. text-to-image, image-edit, multi-image-reference, mask-inpainting, image-to-video, text-rendering, text-to-vector-svg; route by these, never by model name",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "known_strengths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "known_weaknesses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "input_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "max_refs": {
            "type": [
              "integer",
              "null"
            ]
          },
          "resolution": {
            "type": [
              "string",
              "null"
            ]
          },
          "pricing_snapshot": {
            "oneOf": [
              {
                "$ref": "common.schema.json#/$defs/snapshot"
              },
              {
                "type": "null"
              }
            ]
          },
          "latency_snapshot": {
            "oneOf": [
              {
                "$ref": "common.schema.json#/$defs/snapshot"
              },
              {
                "type": "null"
              }
            ]
          },
          "licensing": {
            "type": [
              "string",
              "null"
            ]
          },
          "api": {
            "type": "object",
            "properties": {
              "async": {
                "type": "boolean"
              },
              "webhooks": {
                "type": "boolean"
              },
              "idempotency": {
                "type": "string"
              },
              "caching": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "last_verified": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "access": {
            "type": "string",
            "description": "how it is reachable: direct, fal, Runway, Higgsfield CLI ... (aggregator prices differ: separate rows when they matter)"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "est_unit_cost": {
            "type": [
              "object",
              "null"
            ],
            "description": "router-usable single number derived from pricing_snapshot; null when token-priced or unknown (estimate before spending)",
            "required": [
              "amount",
              "currency",
              "per"
            ],
            "properties": {
              "amount": {
                "type": "number"
              },
              "currency": {
                "type": "string"
              },
              "per": {
                "enum": [
                  "image",
                  "second",
                  "megapixel",
                  "operation"
                ]
              },
              "basis": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "benchmark_results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "task",
                "date",
                "result"
              ],
              "properties": {
                "task": {
                  "type": "string"
                },
                "date": {
                  "type": "string"
                },
                "result": {
                  "type": "string"
                },
                "experiment_id": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "confidence": {
            "$ref": "common.schema.json#/$defs/confidence"
          },
          "status": {
            "enum": [
              "active",
              "watch",
              "deprecated",
              "shut_down"
            ]
          },
          "routes": {
            "type": "array",
            "description": "where the model can be called other than at its maker, each with that host's own endpoint id and price; an estimate for a call through a host uses only that host's price",
            "items": {
              "type": "object",
              "required": [
                "provider",
                "endpoint_id",
                "source",
                "last_verified"
              ],
              "properties": {
                "provider": {
                  "type": "string",
                  "description": "provider id in registry/providers.json, e.g. fal"
                },
                "endpoint_id": {
                  "type": "string",
                  "description": "exact id the host's API takes, e.g. the fal model path"
                },
                "price": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "required": [
                    "currency",
                    "per"
                  ],
                  "properties": {
                    "amount": {
                      "type": "number",
                      "description": "price per unit; with by_quality, the highest listed price (a request is priced from by_quality, never from this)"
                    },
                    "currency": {
                      "type": "string"
                    },
                    "per": {
                      "enum": [
                        "image",
                        "second",
                        "megapixel",
                        "operation",
                        "token"
                      ]
                    },
                    "basis": {
                      "type": "string"
                    },
                    "first_amount": {
                      "type": "number",
                      "description": "per megapixel: price of the first megapixel when it differs from the rest (amount is then each extra megapixel)"
                    },
                    "counts": {
                      "enum": [
                        "output",
                        "input_and_output"
                      ],
                      "description": "per megapixel: which pixels are billed; default output"
                    },
                    "rounding": {
                      "enum": [
                        "up",
                        "not_stated"
                      ],
                      "description": "per megapixel: how the host rounds; both are estimated as rounding each image up to the next megapixel"
                    },
                    "by_quality": {
                      "type": "object",
                      "description": "per image: price by the request's quality parameter, verified only at the sizes listed in sizes; a request without a listed quality or size is unpriced",
                      "additionalProperties": {
                        "type": "number"
                      }
                    },
                    "quality_param": {
                      "type": "string",
                      "description": "per image with by_quality: the request param that names the quality; default quality"
                    },
                    "sizes": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[0-9]+x[0-9]+$"
                      },
                      "description": "per image with by_quality: the output sizes (WxH) the prices were verified at; other sizes are unpriced"
                    },
                    "per_token": {
                      "type": "object",
                      "description": "per token: price per 1M tokens of each kind. Estimated only from the request's token_estimate, which must give input_text and output_image (and input_image when the request carries images); output_text counts when given; cached prices are never assumed (the uncached price is an upper bound). Otherwise the call is unpriced",
                      "properties": {
                        "input_text": {
                          "type": [
                            "number",
                            "null"
                          ]
                        },
                        "cached_input_text": {
                          "type": [
                            "number",
                            "null"
                          ]
                        },
                        "output_text": {
                          "type": [
                            "number",
                            "null"
                          ]
                        },
                        "input_image": {
                          "type": [
                            "number",
                            "null"
                          ]
                        },
                        "cached_input_image": {
                          "type": [
                            "number",
                            "null"
                          ]
                        },
                        "output_image": {
                          "type": [
                            "number",
                            "null"
                          ]
                        }
                      },
                      "additionalProperties": false
                    },
                    "source": {
                      "type": "string",
                      "description": "where this price was read, when it differs from the route source"
                    }
                  },
                  "additionalProperties": false,
                  "anyOf": [
                    {
                      "required": [
                        "amount"
                      ]
                    },
                    {
                      "required": [
                        "per_token"
                      ]
                    }
                  ]
                },
                "source": {
                  "type": "string"
                },
                "last_verified": {
                  "$ref": "common.schema.json#/$defs/date"
                },
                "notes": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "tier": {
            "enum": [
              "flagship",
              "standard",
              "draft"
            ],
            "description": "quality tier from the maker's positioning and public arenas, not a benchmark on your task: flagship for finals, draft for cheap probes; absent = standard. cstack route prefers flagship unless asked for draft"
          },
          "quality": {
            "description": "measured quality: a dated rank on a public leaderboard (one object, or an array for several boards). cstack route ranks by it while it is fresh (30 days) and warns when it is older or missing; recorded from the board itself, never inferred",
            "oneOf": [
              {
                "$ref": "#/$defs/quality"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/quality"
                },
                "minItems": 1
              }
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "quality": {
      "type": "object",
      "required": [
        "leaderboard",
        "rank",
        "as_of",
        "source"
      ],
      "properties": {
        "leaderboard": {
          "type": "string",
          "description": "which board, e.g. Artificial Analysis text-to-image arena"
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "description": "position on that board; lower is better"
        },
        "as_of": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "source": {
          "type": "string",
          "pattern": "^https://"
        }
      },
      "additionalProperties": false
    }
  }
}
