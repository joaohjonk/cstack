{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cstack.dev/schemas/founder-brief.schema.json",
  "title": "Founder brief",
  "description": "Output of /brief in founding mode, for a brand from zero: the founder interviewed the way a good studio takes a brief, before research, references or territories. Every answer is the founder's own words or marked UNKNOWN; nothing is invented.",
  "type": "object",
  "required": [
    "id",
    "brand_id",
    "date",
    "why_it_exists",
    "customer",
    "brand_as_person",
    "assets_and_inspirations",
    "owner_approval"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "brand_id": {
      "type": "string"
    },
    "date": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "interview": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string",
          "description": "who asked"
        },
        "founder": {
          "type": "string",
          "description": "who answered"
        },
        "rounds": {
          "type": "integer",
          "minimum": 1
        },
        "notes_ref": {
          "type": "string",
          "description": "transcript or notes, workspace-relative"
        },
        "conflicts": {
          "type": "array",
          "description": "where a later round contradicts an earlier one, and which answer the brief keeps",
          "items": {
            "type": "object",
            "required": [
              "about",
              "earlier",
              "later"
            ],
            "properties": {
              "about": {
                "type": "string"
              },
              "earlier": {
                "type": "string",
                "description": "the earlier answer, with its round"
              },
              "later": {
                "type": "string",
                "description": "the later answer, with its round"
              },
              "kept": {
                "enum": [
                  "earlier",
                  "later",
                  "both",
                  "open"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "why_it_exists": {
      "type": "object",
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "description": "why this brand should exist, in the founder's words"
        },
        "origin": {
          "type": "string",
          "description": "the founder's story, instinct or problem behind it"
        },
        "problem": {
          "type": "string",
          "description": "the problem it solves in the world, if any"
        },
        "cultural_space": {
          "type": "string",
          "description": "the cultural space it steps into"
        },
        "conviction": {
          "type": "string",
          "description": "what the founder believes the world will want more of"
        },
        "ambition": {
          "type": "string",
          "description": "the boundary the founder wants to push, and how design should make the customer's experience better"
        }
      },
      "additionalProperties": false
    },
    "customer": {
      "type": "object",
      "description": "customer first: who it is for, as the founder knows them",
      "required": [
        "who",
        "evidence"
      ],
      "properties": {
        "who": {
          "type": "string"
        },
        "moment": {
          "type": "string",
          "description": "when and where they meet the product"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "enum": [
            "observed",
            "told",
            "assumed",
            "unknown"
          ]
        },
        "cohorts": {
          "type": "array",
          "description": "the groups inside the customer the founder names (an age cohort, a scene, a store's regulars), each a short line",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "product": {
      "type": "object",
      "description": "what is made and the founder's stance on it: often half of why the brand exists",
      "properties": {
        "what": {
          "type": "string",
          "description": "the product or service in plain words"
        },
        "stance": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "positions the founder holds (ingredients, sourcing, materials, what is left out)"
        },
        "functional": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "what it does beyond the core (added benefits, features)"
        },
        "range": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "first products, sizes, formats, and the range's boundaries"
        },
        "never": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "what the product will never be or contain"
        }
      },
      "additionalProperties": false
    },
    "market": {
      "type": "object",
      "description": "where the brand sits in its market, in the founder's words",
      "properties": {
        "price_position": {
          "enum": [
            "value",
            "mass",
            "masstige",
            "premium",
            "luxury"
          ],
          "description": "the price the founder wants to be read at"
        },
        "price_note": {
          "type": "string",
          "description": "the founder's own words on price, e.g. mass hype at a premium price"
        },
        "anchor": {
          "type": "string",
          "description": "the 'better X' brand the founder measures against, as the founder says it"
        },
        "trend_horizon": {
          "type": "string",
          "description": "how long the bet must hold: this season's flavour, a few years, a generation"
        }
      },
      "additionalProperties": false
    },
    "brand_as_person": {
      "type": "object",
      "description": "a brand acts like a person: a name, a look, places, the company it keeps",
      "properties": {
        "name": {
          "type": "string",
          "description": "a name, or the naming brief"
        },
        "personality": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "looks_like": {
          "type": "string",
          "description": "colour, mark, type and material cues the founder already sees"
        },
        "sounds_like": {
          "type": "string"
        },
        "talks_to_customer": {
          "type": "string",
          "description": "how the brand speaks to its customer, and where"
        },
        "hangs_out": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "company_it_keeps": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "brands, people or places it sits next to"
          }
        },
        "sold_at": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "never": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "what it would never do or look like"
          }
        }
      },
      "additionalProperties": false
    },
    "assets_and_inspirations": {
      "type": "object",
      "description": "what the founder brings: assets in hand, and inspirations to bring back to them as references",
      "properties": {
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "what"
            ],
            "properties": {
              "what": {
                "type": "string"
              },
              "ref": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "keep",
                  "open",
                  "drop"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "inspirations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ref",
              "what_draws_them"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "description": "a brand, object, place, school or work, by name or link"
              },
              "kind": {
                "enum": [
                  "brand",
                  "packaging",
                  "object",
                  "place",
                  "culture",
                  "design_school",
                  "person_public",
                  "other"
                ]
              },
              "what_draws_them": {
                "type": "string",
                "description": "the mechanism the founder likes, not the look"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "amendments": {
      "type": "array",
      "description": "each time an approved brief was reopened (`cstack brief reopen`): when, why, and the approval it replaced",
      "items": {
        "type": "object",
        "required": [
          "date",
          "reason"
        ],
        "properties": {
          "date": {
            "$ref": "common.schema.json#/$defs/date"
          },
          "reason": {
            "type": "string"
          },
          "by": {
            "type": "string"
          },
          "previous": {
            "type": "object",
            "description": "the approval this reopen replaced",
            "properties": {
              "status": {
                "type": "string"
              },
              "by": {
                "type": "string"
              },
              "date": {
                "$ref": "common.schema.json#/$defs/date"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "owner_approval": {
      "type": "object",
      "description": "the founder's yes to this brief; research, references and territories wait for it",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "owner_approved",
            "reopened"
          ]
        },
        "by": {
          "type": "string"
        },
        "date": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "written by `cstack brief approve`: the content the founder said yes to; the make gate refuses the brief once it no longer matches"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
