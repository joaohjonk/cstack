{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cstack.dev/schemas/skill-meta.schema.json",
  "title": "Skill metadata",
  "description": "Section 9 / 24A. Machine-readable twin of SKILL.md so the runtime can search the catalog without loading every skill.",
  "type": "object",
  "required": [
    "slug",
    "type",
    "summary",
    "triggers",
    "required_inputs",
    "outputs",
    "compatible_hosts",
    "cost_class",
    "context_class",
    "mutating",
    "destructive",
    "version",
    "status"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "type": {
      "enum": [
        "capability",
        "composite",
        "playbook"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 200
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "not_for": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reads": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "writes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compatible_hosts": {
      "type": "array",
      "items": {
        "enum": [
          "claude-code",
          "codex",
          "cursor",
          "gemini-cli",
          "opencode",
          "any"
        ]
      }
    },
    "required_providers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "optional_providers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cost_class": {
      "enum": [
        "free",
        "low",
        "medium",
        "high"
      ]
    },
    "context_class": {
      "enum": [
        "s",
        "m",
        "l"
      ]
    },
    "mutating": {
      "type": "boolean"
    },
    "destructive": {
      "type": "boolean"
    },
    "handoff": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "last_verified": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "stable",
        "beta",
        "stub",
        "deprecated"
      ],
      "description": "promotion past stub needs a linked run record or eval result"
    },
    "phase": {
      "type": "string"
    },
    "approval_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "after_step"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "after_step": {
            "type": "string"
          },
          "artifact": {
            "type": "string"
          },
          "never_self_approve": {
            "type": "boolean"
          }
        }
      }
    },
    "depends_on_fields": {
      "type": "array",
      "description": "brand-system field paths outputs pin (written to lineage brand_refs)",
      "items": {
        "type": "string"
      }
    },
    "deterministic_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generative_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fallback": {
      "type": "object",
      "properties": {
        "when_missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "enum": [
            "brief-only",
            "degraded",
            "blocked",
            "local"
          ]
        }
      }
    },
    "output_contract": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "headings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "baseline": {
      "enum": [
        "brief",
        "reference",
        "last_approved",
        "incumbent",
        "absolute",
        "n/a"
      ],
      "description": "what this skill's judgments are relative to"
    },
    "budget": {
      "type": "object",
      "properties": {
        "skill_md_tokens_max": {
          "type": "integer"
        },
        "refs_tokens_max": {
          "type": "integer"
        }
      }
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "host_overrides": {
      "type": "object"
    },
    "trigger_eval": {
      "type": "string"
    }
  },
  "additionalProperties": false
}