{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cstack.dev/schemas/skill-meta.schema.json",
  "title": "Skill metadata",
  "description": "Machine-readable twin of SKILL.md: what the index, search, health and validate read. Prose (process, tools, failure modes) lives only in SKILL.md; evals are derived from evals/fixtures/*.yaml `skills:`.",
  "type": "object",
  "required": [
    "slug",
    "type",
    "summary",
    "triggers",
    "required_inputs",
    "outputs",
    "cost_class",
    "context_class",
    "mutating",
    "status"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "type": {
      "enum": [
        "capability",
        "composite",
        "playbook"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 200
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_providers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cost_class": {
      "enum": [
        "free",
        "low",
        "medium",
        "high"
      ]
    },
    "context_class": {
      "enum": [
        "s",
        "m",
        "l"
      ]
    },
    "mutating": {
      "type": "boolean"
    },
    "handoff": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_verified": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "stable",
        "beta",
        "stub",
        "deprecated"
      ],
      "description": "promotion past stub needs a linked run record or eval result"
    },
    "approval_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "after_step"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "after_step": {
            "type": "string"
          },
          "artifact": {
            "type": "string"
          },
          "never_self_approve": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "depends_on_fields": {
      "type": "array",
      "description": "brand-system field paths outputs pin (written to lineage brand_refs)",
      "items": {
        "type": "string"
      }
    },
    "fallback": {
      "type": "object",
      "properties": {
        "when_missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "enum": [
            "brief-only",
            "degraded",
            "blocked",
            "local"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
