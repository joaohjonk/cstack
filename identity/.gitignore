# secrets never live in the workspace
.env
.env.*
# large binaries: track with git-lfs or keep in a bucket; lineage sidecars (*.gen.json) stay tracked
work/**/*.png
work/**/*.jpg
work/**/*.jpeg
work/**/*.webp
work/**/*.mp4
work/**/*.mov
# third-party captures are reference only: never commit or publish them
work/browse/
work/competitors/*/
state/pending-jobs/
state/cache/
